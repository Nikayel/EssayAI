// EssayEdge AI - Database Schema
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  STUDENT
  PARENT
  COUNSELOR
  REVIEWER
  ADMIN
}

enum EssayType {
  PERSONAL_STATEMENT
  WHY_US
  SUPPLEMENTAL
  ACTIVITY
  OTHER
}

enum OrderStatus {
  PENDING
  PAID
  IN_PROGRESS
  COMPLETED
  CANCELLED
  REFUNDED
}

enum ReviewStatus {
  ASSIGNED
  IN_PROGRESS
  DELIVERED
  REVISION_REQUESTED
}

enum Package {
  FREE
  AI_LITE
  AI_PRO_SINGLE
  AI_PRO_MONTHLY
  // Ivy League packages
  IVY_SINGLE
  IVY_BUNDLE_3
  IVY_BUNDLE_8
  IVY_UNLIMITED
  IVY_HUMAN_COMBO
  IVY_PREMIUM_BUNDLE
  // Human review packages
  HUMAN_LITE
  HUMAN_OVERALL_REVIEW
  HUMAN_FULL_1
  HUMAN_FULL_3
  HUMAN_FULL_5
  DEEP_REVIEW
  EXPERT_QA_PREMIUM
  EXPERT_QA_STANDARD
  RUSH_ADDON
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  role          UserRole  @default(STUDENT)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  profile       Profile?
  essays        Essay[]
  orders        Order[]
  messages      Message[]
  reviewsGiven  Review[]  @relation("ReviewerReviews")

  @@index([email])
  @@map("users")
}

model Profile {
  id              String    @id @default(cuid())
  userId          String    @unique
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  name            String?
  gradeLevel      String?
  intendedMajor   String?
  schoolYear      Int?
  dob             DateTime?
  guardianEmail   String?
  regions         String[]
  goals           String?
  consentFlags    Json?
  toneSample      String?   @db.Text
  toneEmbedding   Json?     // Store embeddings as JSON array

  // INTAKE FLOW - Critical context for better analysis
  graduationYear     Int?              // 2025, 2026, etc.
  applicationCycle   String?           // "2025-2026"
  spike              String?   @db.Text // Main narrative/theme across apps
  topActivities      String[]          // Top 3-5 activities/achievements
  biggestWorry       String?           // What concerns them most
  previousReviews    Boolean?          // Has anyone else reviewed?
  howHeardAboutUs    String?           // Attribution tracking
  isOnboarded        Boolean   @default(false)

  // =========================================================================
  // ENHANCED INTAKE - Demographics & Background
  // =========================================================================
  isFirstGen              Boolean?          // First-generation college student
  familyEducationLevel    String?           // no_college, some_college, bachelors, graduate
  householdIncome         String?           // <30k, 30-75k, 75-150k, 150k+, prefer_not_say
  isInternational         Boolean?          // International student
  countryOfOrigin         String?           // Country of citizenship
  primaryLanguage         String?           // Primary language at home
  immigrationStory        String?           // citizen, immigrant_self, immigrant_parent, visa, undocumented
  geographicContext       String?           // rural, suburban, urban
  schoolType              String?           // public, private, charter, magnet, homeschool, international
  familyResponsibilities  String[]          // caregiving, work_to_support, sibling_care, translation

  // =========================================================================
  // ENHANCED INTAKE - Academic Context
  // =========================================================================
  academicInterests       String[]          // Areas of intellectual curiosity
  intellectualPassion     String?   @db.Text // "What keeps you up at night?"
  hasResearchExperience   Boolean?          // Research experience
  researchDescription     String?   @db.Text // Description of research
  academicChallenges      String?   @db.Text // Context for grade dips, etc.

  // =========================================================================
  // ENHANCED INTAKE - Activities & Experience (structured JSON)
  // =========================================================================
  activitiesStructured    Json?             // Array of {name, role, hours, years, impact}
  workExperience          Json?             // Array of {job, hours, reason}
  leadershipRoles         String[]          // Leadership positions held
  summerExperiences       String?   @db.Text // How they use unstructured time

  // =========================================================================
  // ENHANCED INTAKE - Personal Identity & Story
  // =========================================================================
  identityFactors         String[]          // race_ethnicity, gender, lgbtq, disability, etc.
  significantChallenges   String?   @db.Text // Major obstacles overcome
  uniquePerspective       String?   @db.Text // "What makes you different?"
  whatAOsShouldKnow       String?   @db.Text // "What's not in your app?"

  // =========================================================================
  // ENHANCED INTAKE - Voice Calibration
  // =========================================================================
  writingStyle            String?           // formal, conversational, storytelling, analytical
  usesHumor               Boolean?          // Do they use humor in writing?

  // Referral program
  referralCode       String?   @unique // User's unique referral code

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  targetSchools   TargetSchool[]

  @@map("profiles")
}

// Portfolio: Track all target schools with deadlines
model TargetSchool {
  id              String      @id @default(cuid())
  profileId       String
  profile         Profile     @relation(fields: [profileId], references: [id], onDelete: Cascade)

  schoolName      String
  deadlineType    DeadlineType
  deadline        DateTime
  status          ApplicationStatus @default(NOT_STARTED)
  priority        Int         @default(5) // 1-10, higher = more important
  notes           String?     @db.Text

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  // Link essays to this target school
  essays          Essay[]     @relation("TargetSchoolEssays")

  @@unique([profileId, schoolName])
  @@index([profileId])
  @@index([deadline])
  @@map("target_schools")
}

enum DeadlineType {
  EARLY_DECISION
  EARLY_ACTION
  REGULAR_DECISION
  ROLLING
  RESTRICTIVE_EA
}

enum ApplicationStatus {
  NOT_STARTED
  IN_PROGRESS
  ESSAYS_DRAFTING
  ESSAYS_COMPLETE
  SUBMITTED
  ACCEPTED
  REJECTED
  WAITLISTED
  DEFERRED
}

model Essay {
  id              String      @id @default(cuid())
  userId          String
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  type            EssayType
  promptText      String      @db.Text
  targetSchool    String?
  wordLimit       Int?

  // Link to portfolio target school
  targetSchoolId  String?
  targetSchoolRef TargetSchool? @relation("TargetSchoolEssays", fields: [targetSchoolId], references: [id])

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  versions        EssayVersion[]
  orders          Order[]

  @@index([userId])
  @@index([targetSchoolId])
  @@map("essays")
}

model EssayVersion {
  id              String      @id @default(cuid())
  essayId         String
  essay           Essay       @relation(fields: [essayId], references: [id], onDelete: Cascade)

  content         String      @db.Text
  versionIndex    Int
  toneEmbedding   Json?       // Store embeddings as JSON array

  createdAt       DateTime    @default(now())

  analyses        AIAnalysis[]
  rewrites        Rewrite[]
  reviews         Review[]
  analysisHistory AnalysisHistory[]

  @@unique([essayId, versionIndex])
  @@index([essayId])
  @@map("essay_versions")
}

model AIAnalysis {
  id              String          @id @default(cuid())
  versionId       String
  version         EssayVersion    @relation(fields: [versionId], references: [id], onDelete: Cascade)

  analysisJson    Json            // Full structured analysis
  overallScore    Float
  modelRef        String          // e.g., "claude-3-sonnet-20240229"

  createdAt       DateTime        @default(now())

  commonsFlags    CommonsFlag[]

  @@index([versionId])
  @@map("ai_analyses")
}

model CommonsFlag {
  id              String      @id @default(cuid())
  analysisId      String
  analysis        AIAnalysis  @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  key             String      // e.g., "about_applicant", "jargon_overuse"
  flag            Boolean
  evidence        Json?       // Array of evidence snippets

  @@index([analysisId])
  @@map("commons_flags")
}

model Rewrite {
  id              String          @id @default(cuid())
  versionId       String
  version         EssayVersion    @relation(fields: [versionId], references: [id], onDelete: Cascade)

  rewriteJson     Json            // Structured rewrite suggestions
  modelRef        String

  createdAt       DateTime        @default(now())

  @@index([versionId])
  @@map("rewrites")
}

model Order {
  id              String        @id @default(cuid())
  userId          String
  user            User          @relation(fields: [userId], references: [id])
  essayId         String?
  essay           Essay?        @relation(fields: [essayId], references: [id])

  package         Package
  amount          Int           // In cents
  status          OrderStatus   @default(PENDING)

  stripeSessionId String?       @unique
  stripePaymentId String?

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  reviews         Review[]
  messages        Message[]
  refund          Refund?

  @@index([userId])
  @@index([status])
  @@map("orders")
}

model Review {
  id              String          @id @default(cuid())
  orderId         String
  order           Order           @relation(fields: [orderId], references: [id])
  versionId       String
  version         EssayVersion    @relation(fields: [versionId], references: [id])
  reviewerId      String?
  reviewer        User?           @relation("ReviewerReviews", fields: [reviewerId], references: [id])

  status          ReviewStatus    @default(ASSIGNED)
  dueAt           DateTime
  deliveredAt     DateTime?
  assetsRef       String?         // S3/Supabase Storage reference to annotated docs
  summaryText     String?         @db.Text

  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  comments        ReviewComment[]

  @@index([orderId])
  @@index([reviewerId])
  @@index([status])
  @@map("reviews")
}

model ReviewComment {
  id              String      @id @default(cuid())
  reviewId        String
  review          Review      @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  locationRef     String?     // Paragraph or line reference
  commentText     String      @db.Text

  createdAt       DateTime    @default(now())

  @@index([reviewId])
  @@map("review_comments")
}

model Message {
  id              String      @id @default(cuid())
  orderId         String
  order           Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  senderId        String
  sender          User        @relation(fields: [senderId], references: [id])

  text            String      @db.Text
  attachmentUrl   String?

  createdAt       DateTime    @default(now())

  @@index([orderId])
  @@map("messages")
}

model Reviewer {
  id              String      @id @default(cuid())
  userId          String      @unique

  // Profile info for social proof
  displayName     String?
  photoUrl        String?
  bio             String?     @db.Text
  credentials     String?     @db.Text // "Former Harvard AO", "English PhD"
  title           String?     // "Senior Essay Coach"
  yearsExperience Int?

  // Stats for social proof
  rating          Float?      // Average rating from students
  reviewCount     Int         @default(0) // Total essays reviewed
  successStories  Int         @default(0) // Students accepted to target school

  capacity        Int         @default(5) // Weekly review capacity
  specialties     String[]    // e.g., ["PERSONAL_STATEMENT", "WHY_US"]
  ivyExpertise    String[]    // e.g., ["harvard", "yale", "princeton"]
  isActive        Boolean     @default(true)
  isFeatured      Boolean     @default(false) // Show on landing page

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@map("reviewers")
}

model School {
  id              String      @id @default(cuid())
  name            String      @unique
  factsJson       Json?       // Programs, values, mission, etc.

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([name])
  @@map("schools")
}

model PromptTemplate {
  id              String      @id @default(cuid())
  name            String      @unique
  systemText      String      @db.Text
  userTemplate    String      @db.Text
  schemaRef       String?     // Reference to JSON schema

  version         Int         @default(1)
  isActive        Boolean     @default(true)

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@map("prompt_templates")
}

model Refund {
  id              String      @id @default(cuid())
  orderId         String      @unique
  order           Order       @relation(fields: [orderId], references: [id])

  amount          Int         // In cents
  reason          String?     @db.Text
  stripeRefundId  String?

  createdAt       DateTime    @default(now())

  @@map("refunds")
}

model AuditLog {
  id              String      @id @default(cuid())
  userId          String?
  action          String
  resource        String?
  details         Json?

  createdAt       DateTime    @default(now())

  @@index([userId])
  @@index([createdAt])
  @@map("audit_logs")
}

model AnalyticsEvent {
  id              String      @id @default(cuid())
  userId          String?
  event           String
  properties      Json?

  createdAt       DateTime    @default(now())

  @@index([event])
  @@index([userId])
  @@index([createdAt])
  @@map("analytics_events")
}

// Referral Program
model Referral {
  id              String      @id @default(cuid())
  referrerId      String      // User who referred
  referredEmail   String      // Email of person invited
  referredUserId  String?     // Set when they sign up
  code            String      @unique // Unique referral code

  status          ReferralStatus @default(PENDING)
  rewardAmount    Int?        // Credit in cents earned
  rewardClaimed   Boolean     @default(false)

  createdAt       DateTime    @default(now())
  convertedAt     DateTime?   // When referral signed up
  purchasedAt     DateTime?   // When referral made first purchase

  @@index([referrerId])
  @@index([referredEmail])
  @@index([code])
  @@map("referrals")
}

enum ReferralStatus {
  PENDING       // Invited but not signed up
  SIGNED_UP     // Signed up but no purchase
  CONVERTED     // Made a purchase - reward earned
  EXPIRED       // Link expired (30 days)
}

// Lead capture for free resources / email list
model Lead {
  id              String      @id @default(cuid())
  email           String      @unique
  name            String?
  source          String      // Where they came from (essay_examples, deadline_calc, etc.)

  userId          String?     // Set if they create account
  convertedAt     DateTime?   // When they became a paying customer

  metadata        Json?       // Extra info (school interest, grade, etc.)

  createdAt       DateTime    @default(now())

  @@index([email])
  @@index([source])
  @@map("leads")
}

// =============================================================================
// RAG SYSTEM TABLES
// =============================================================================

// Example Essays - Successful essays for retrieval
model ExampleEssay {
  id              String      @id @default(cuid())
  schoolId        String      // harvard, yale, etc.
  essayType       String      // PERSONAL_STATEMENT, WHY_US, etc.
  promptId        String?     // Links to specific prompt

  // Content (anonymized - no PII)
  contentSnippet  String      @db.Text  // 200-500 word excerpt
  contentHash     String      @unique   // For deduplication

  // Metadata
  outcome         String?     // ACCEPTED, WAITLIST, etc.
  scoreRange      String?     // 90-100, 80-89, etc.
  themeTags       String[]    // ['overcoming-adversity', 'intellectual-curiosity']
  spikeCategory   String?     // 'stem-research', 'arts', 'social-impact'

  // What made it work
  strengthNotes   String?     @db.Text
  keyTechniques   String[]    // ['in-medias-res', 'circular-structure']

  // Embedding (stored as JSON array of floats)
  embedding       Json?       // 1536-dimensional vector

  isActive        Boolean     @default(true)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([schoolId, essayType])
  @@index([spikeCategory])
  @@map("example_essays")
}

// Feedback Patterns - Common issues with proven solutions
model FeedbackPattern {
  id              String      @id @default(cuid())

  // Pattern identification
  issueType       String      // 'generic_opening', 'weak_reflection', etc.
  issueCategory   String      // 'structure', 'content', 'style', 'fit'
  essayType       String?     // Which essay types this applies to
  schoolId        String?     // School-specific patterns (optional)

  // The pattern
  patternName     String      // Human-readable name
  description     String      @db.Text  // Full description
  exampleBefore   String?     @db.Text  // Original problematic text
  exampleAfter    String?     @db.Text  // Improved version
  fixStrategy     String?     @db.Text  // How to fix it

  // Impact data (updated via feedback loop)
  avgScoreImprovement Float   @default(0)
  frequency       Int         @default(0)  // How often we've seen this
  successRate     Float       @default(0)  // % of students who improved

  // Embedding for semantic matching
  embedding       Json?

  // Severity: 1-5 (5 = critical)
  severity        Int         @default(3)

  isActive        Boolean     @default(true)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@unique([issueType, essayType, schoolId])
  @@index([issueCategory])
  @@index([essayType])
  @@map("feedback_patterns")
}

// School Insights - AO quotes, tips, what works
model SchoolInsight {
  id              String      @id @default(cuid())
  schoolId        String

  // Content
  insightType     String      // 'ao_quote', 'student_tip', 'common_mistake', 'what_works', 'program_detail'
  content         String      @db.Text
  source          String?     // Where this came from

  // Applicability
  essayTypes      String[]    // Which essay types this applies to
  relevanceScore  Float       @default(3)  // 1-5 importance

  // Embedding for semantic retrieval
  embedding       Json?

  isActive        Boolean     @default(true)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([schoolId])
  @@index([insightType])
  @@map("school_insights")
}

// Analysis History - Store every analysis for feedback loop
model AnalysisHistory {
  id              String      @id @default(cuid())

  // Links
  essayVersionId  String
  essayVersion    EssayVersion @relation(fields: [essayVersionId], references: [id], onDelete: Cascade)
  userId          String

  // Essay metadata (for retrieval)
  schoolId        String?
  essayType       String

  // Scores achieved
  overallScore    Float
  dimensionScores Json        // {authenticity: 5, reflection: 4, ...}

  // What issues were found
  issuesIdentified String[]   // ['generic_opening', 'weak_reflection']
  patternsMatched  String[]   // Pattern IDs that matched
  suggestionsGiven Json?      // Full suggestions array

  // Improvement tracking
  previousVersionScore Float?  // Score before revision
  scoreDelta      Float?       // Improvement amount

  // Embedding of the essay (for finding similar)
  essayEmbedding  Json?

  // RAG context used
  ragContextUsed  Json?       // {exampleIds: [], patternIds: [], insightIds: []}

  createdAt       DateTime    @default(now())

  @@index([userId])
  @@index([schoolId, essayType])
  @@index([createdAt])
  @@map("analysis_history")
}

// =============================================================================
// CONFIGURATION SYSTEM
// =============================================================================

// Admin-editable configuration overrides
model ConfigOverride {
  id        String   @id @default(cuid())
  key       String   @unique  // Dot notation: "pricing.tiers.quick"
  value     Json               // The override value
  updatedAt DateTime @updatedAt
  updatedBy String?            // Admin user ID who made the change

  @@index([key])
  @@map("config_overrides")
}

// Admissions cycle data (updated annually)
model AdmissionsCycle {
  id              String   @id @default(cuid())
  cycle           String   @unique  // e.g., "2025-2026"
  startDate       DateTime           // When this cycle begins (Aug 1)
  endDate         DateTime           // When this cycle ends (Apr 1)
  isActive        Boolean  @default(false)

  // Aggregate stats (populated after cycle ends)
  totalAnalyses   Int?
  avgScore        Float?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  schoolData      SchoolCycleData[]

  @@index([isActive])
  @@map("admissions_cycles")
}

// School-specific data per admissions cycle
model SchoolCycleData {
  id              String          @id @default(cuid())
  cycleId         String
  cycle           AdmissionsCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  schoolId        String          // harvard, yale, etc.

  // Deadlines
  earlyDeadline   DateTime?
  regularDeadline DateTime?

  // Stats (updated after cycle ends)
  acceptanceRate  Float?
  applicantCount  Int?
  acceptedCount   Int?

  // Essay prompts for this cycle
  essayPrompts    Json?           // Array of {type, prompt, wordLimit}

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([cycleId, schoolId])
  @@index([schoolId])
  @@map("school_cycle_data")
}

// =============================================================================
// TIERED ANALYSIS SYSTEM
// =============================================================================

// Analysis sessions (tracks each analysis request)
model AnalysisSession {
  id              String        @id @default(cuid())
  userId          String?
  userEmail       String        // For guest users or notifications

  // Tier and payment
  tier            String        // 'quick', 'standard', 'premium'
  paidAmount      Int?          // In cents
  stripePaymentId String?

  // Input
  essayText       String        @db.Text
  intakeData      Json          // Full StudentIntake object
  targetSchool    String?
  essayType       String?

  // Status
  status          AnalysisStatus @default(PENDING)

  // Results
  aiResult        Json?         // Full AI analysis result
  aiScore         Float?        // Overall score
  aiCompletedAt   DateTime?

  // Human review (Premium tier)
  humanReviewId   String?       @unique
  humanReview     HumanReviewAssignment? @relation(fields: [humanReviewId], references: [id])

  // Metadata
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([userId])
  @@index([userEmail])
  @@index([status])
  @@index([createdAt])
  @@map("analysis_sessions")
}

enum AnalysisStatus {
  PENDING           // Awaiting payment or processing
  ANALYZING         // AI analysis in progress
  AI_COMPLETE       // AI done, awaiting human (if premium)
  HUMAN_QUEUED      // In human review queue
  HUMAN_IN_PROGRESS // Human reviewing
  COMPLETED         // Fully complete
  FAILED            // Error occurred
}

// =============================================================================
// HUMAN REVIEW SYSTEM (Premium Tier)
// =============================================================================

// Human reviewer profiles (separate from User for flexibility)
model HumanReviewer {
  id              String      @id @default(cuid())
  email           String      @unique
  name            String
  credentials     String      // "Former Yale AO, 8 years"
  bio             String?     @db.Text

  // Specialties
  schoolExpertise String[]    // ["harvard", "yale"]
  essayExpertise  String[]    // ["personal_statement", "why_us"]

  // Capacity management
  maxActiveReviews Int        @default(5)
  isActive        Boolean     @default(true)

  // Stats
  totalReviews    Int         @default(0)
  avgRating       Float?

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  assignments     HumanReviewAssignment[]

  @@index([isActive])
  @@map("human_reviewers")
}

// Human review assignments
model HumanReviewAssignment {
  id              String        @id @default(cuid())

  // Reviewer assignment
  reviewerId      String?
  reviewer        HumanReviewer? @relation(fields: [reviewerId], references: [id])

  // Status tracking
  status          HumanReviewStatus @default(QUEUED)
  assignedAt      DateTime?
  dueAt           DateTime
  completedAt     DateTime?

  // Data for reviewer (denormalized for easy access)
  studentEmail    String
  essayText       String        @db.Text
  targetSchool    String?
  essayType       String?
  intakeData      Json          // Student background, context
  aiAnalysis      Json          // AI analysis results for reference

  // Reviewer's work (simple - they email student directly)
  internalNotes   String?       @db.Text
  markedDoneAt    DateTime?

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  session         AnalysisSession?

  @@index([reviewerId])
  @@index([status])
  @@index([dueAt])
  @@map("human_review_assignments")
}

enum HumanReviewStatus {
  QUEUED          // Awaiting assignment
  ASSIGNED        // Assigned to reviewer
  IN_PROGRESS     // Reviewer working on it
  COMPLETED       // Done
  OVERDUE         // Past due date
}
