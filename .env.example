# =============================================================================
# EssayEdge AI - Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local or any file with actual secrets!

# =============================================================================
# APPLICATION
# =============================================================================

# Public URL of your application (no trailing slash)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Node environment: development, production, test
NODE_ENV=development

# =============================================================================
# DATABASE (Supabase/PostgreSQL)
# =============================================================================

# PostgreSQL connection string
# For Supabase: Use the pooler connection string from Project Settings > Database
# Format: postgresql://postgres.[project-ref]:[password]@[host]:5432/postgres
DATABASE_URL=postgresql://postgres.xxxxx:YOUR_PASSWORD@aws-0-us-west-1.pooler.supabase.com:5432/postgres

# =============================================================================
# AUTHENTICATION (Supabase)
# =============================================================================

# Supabase project URL
# Find this in: Project Settings > API > Project URL
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co

# Supabase anonymous/public key
# Find this in: Project Settings > API > Project API keys > anon/public
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# =============================================================================
# AI PROVIDERS
# =============================================================================

# Anthropic Claude API Key (Required)
# Get from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-api...

# OpenAI API Key (Required for embeddings)
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Google Gemini API Key (Optional - for multi-provider support)
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIza...

# DeepSeek API Key (Optional - for multi-provider support)
# Get from: https://platform.deepseek.com/
DEEPSEEK_API_KEY=sk-...

# =============================================================================
# PAYMENTS (Stripe)
# =============================================================================

# Stripe Secret Key
# Get from: https://dashboard.stripe.com/apikeys
# Use test key (sk_test_...) for development
STRIPE_SECRET_KEY=sk_test_...

# Stripe Publishable Key (for client-side)
# Get from: https://dashboard.stripe.com/apikeys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Stripe Webhook Secret
# Get from: https://dashboard.stripe.com/webhooks
# For local dev, use Stripe CLI: stripe listen --forward-to localhost:3000/api/webhook/stripe
STRIPE_WEBHOOK_SECRET=whsec_...

# =============================================================================
# EMAIL (Resend)
# =============================================================================

# Resend API Key
# Get from: https://resend.com/api-keys
RESEND_API_KEY=re_...

# =============================================================================
# CRON JOBS
# =============================================================================

# Secret for authenticating cron job requests
# Generate a random string: openssl rand -hex 32
CRON_SECRET=your-random-secret-string

# =============================================================================
# OPTIONAL: ANALYTICS & MONITORING
# =============================================================================

# PostHog (Optional - for product analytics)
# NEXT_PUBLIC_POSTHOG_KEY=phc_...
# NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# Sentry (Optional - for error tracking)
# SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx

# =============================================================================
# OPTIONAL: ADDITIONAL SERVICES
# =============================================================================

# Vercel (if deploying to Vercel)
# These are usually auto-set by Vercel
# VERCEL_URL=
# VERCEL_ENV=

# =============================================================================
# DEVELOPMENT HELPERS
# =============================================================================

# Skip email sending in development (set to "true" to skip)
# SKIP_EMAILS=true

# Enable verbose logging (set to "true" for debug output)
# DEBUG=true
